{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=RxSuite;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Webhooks": {
    "PaymentSecret": ""
  },
  "Jobs": {
    "Enabled": true
  },
  "BusinessRules": {
    "Subscription": {
      "TrialDays": 14,
      "TrialMaxBranches": 2,
      "TrialMaxUsers": 5,
      "TrialPlanCode": "PRO",
      "GraceDays": 7,
      "YearlyPriceMultiplier": 10
    },
    "Security": {
      "MinPasswordLength": 8,
      "MaxFailedLogins": 5,
      "LockoutMinutes": 15
    },
    "Inventory": {
      "NearExpiryDays": 90,
      "AdjustmentApprovalLimit": 1000
    },
    "Purchasing": {
      "OrderApprovalLimit": 20000,
      "MinimumShelfLifeMonths": 6
    },
    "Pos": {
      "UnitPriceRounding": 0.25,
      "ReturnPolicyDays": 14,
      "ShiftVarianceTolerance": 50,
      "BuyerIdentificationThreshold": 150000
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
